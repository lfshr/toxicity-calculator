@inject PatientState Patient
@implements IDisposable

@if (Patient.Species == Species.Cat)
{
    <div class="notice warning" role="note">
        @if (ChildContent is not null)
        {
            @ChildContent
        }
        else
        {
            <strong>These thresholds are for dogs.</strong> @("Cats can be more sensitive, so treat this as a minimum estimate and check a feline reference.")
        }
    </div>
}

@code {
    /// <summary>What to say for cats instead of the general warning, for toxins with their own cat guidance.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    protected override void OnInitialized() => Patient.Changed += Refresh;

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose() => Patient.Changed -= Refresh;
}
