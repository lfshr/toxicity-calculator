@* The patient's species, shared with every other calculator. *@
@inject PatientState Patient
@implements IDisposable

<fieldset class="field species-field">
    <legend>Patient</legend>
    <div class="segmented" role="radiogroup" aria-label="Species">
        <button type="button" role="radio" aria-checked="@(Patient.Species == Species.Dog ? "true" : "false")"
                class="@(Patient.Species == Species.Dog ? "selected" : "")" @onclick="() => Patient.SetSpecies(Species.Dog)">Dog</button>
        <button type="button" role="radio" aria-checked="@(Patient.Species == Species.Cat ? "true" : "false")"
                class="@(Patient.Species == Species.Cat ? "selected" : "")" @onclick="() => Patient.SetSpecies(Species.Cat)">Cat</button>
    </div>
</fieldset>

@code {
    protected override void OnInitialized() => Patient.Changed += Refresh;

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose() => Patient.Changed -= Refresh;
}
