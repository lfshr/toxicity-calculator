@page "/toxins/chocolate"
@inherits ViewModelPage<CalculatorViewModel>
@inject CalculatorViewModel ViewModel

<PageTitle>Chocolate - Vet Calculator</PageTitle>

<PageHeader Title="Chocolate" Intro="Estimate the theobromine and caffeine dose a dog has eaten, and whether to consider inducing emesis." />
<DogOnlyNotice />

<form class="calc-form" @onsubmit="() => Vm.CalculateCommand.ExecuteAsync(null)" @onsubmit:preventDefault>
    <Field Label="Dog's weight" For="weight" Error="@Vm.DogWeightError">
        <NumberInput Id="weight" Value="@Vm.DogWeightKg" ValueChanged="OnWeightChanged" Unit="kg" Placeholder="e.g. 12.5" Invalid="@(Vm.DogWeightError is not null)" />
    </Field>

    <fieldset class="field">
        <legend>What was eaten</legend>
        <div class="segmented wide" role="radiogroup">
            <button type="button" role="radio" aria-checked="@(!Vm.UseCocoaPercent ? "true" : "false")"
                    class="@(!Vm.UseCocoaPercent ? "selected" : "")" @onclick="() => Vm.UseCocoaPercent = false">Type of chocolate</button>
            <button type="button" role="radio" aria-checked="@(Vm.UseCocoaPercent ? "true" : "false")"
                    class="@(Vm.UseCocoaPercent ? "selected" : "")" @onclick="() => Vm.UseCocoaPercent = true">Cocoa % on label</button>
        </div>

        @if (Vm.UseCocoaPercent)
        {
            <Field Label="Cocoa percentage" For="cocoa" Error="@Vm.ChocolateError"
                   Hint="Not for cocoa powder, which is far stronger per gram: choose it by type instead.">
                <NumberInput Id="cocoa" Value="@Vm.CocoaPercent" ValueChanged="v => Vm.CocoaPercent = v" Unit="%" Placeholder="e.g. 70" Invalid="@(Vm.ChocolateError is not null)" />
            </Field>
        }
        else
        {
            <Field Label="Type of chocolate" For="type" Error="@Vm.ChocolateError">
                <select id="type" value="@(Vm.SelectedChocolateType?.Type.ToString() ?? "")" @onchange="OnTypeChanged">
                    <option value="">Choose...</option>
                    @foreach (var option in Vm.ChocolateTypes)
                    {
                        <option value="@option.Type">@option.Name</option>
                    }
                </select>
            </Field>
        }

        <button type="button" class="secondary search-button" @onclick="() => Vm.SearchProductsCommand.ExecuteAsync(null)">
            Search products
        </button>
        @if (Vm.ProductNote is not null)
        {
            <p class="notice info">@Vm.ProductNote</p>
        }
    </fieldset>

    <Field Label="Amount eaten" For="amount" Error="@Vm.AmountEatenError" Hint="If unsure, use the most that could have been eaten.">
        <NumberInput Id="amount" Value="@Vm.AmountEatenGrams" ValueChanged="v => Vm.AmountEatenGrams = v" Unit="g" Placeholder="e.g. 100" Invalid="@(Vm.AmountEatenError is not null)" />
        @if (Vm.WholePackText is not null)
        {
            <button type="button" class="link" @onclick="() => Vm.UseWholePackCommand.Execute(null)">@Vm.WholePackText</button>
        }
    </Field>

    <div class="actions">
        <button type="submit" class="primary">Calculate</button>
        <button type="button" class="secondary" @onclick="ClearForm">Clear</button>
    </div>
</form>

@code {
    protected override CalculatorViewModel Vm => ViewModel;

    protected override void PullWeightFromPatient()
    {
        if (Patient.WeightText.Length > 0)
        {
            Vm.DogWeightKg = Patient.WeightText;
        }
    }

    private void OnWeightChanged(string value)
    {
        Vm.DogWeightKg = value;
        Patient.SetWeight(value);
    }

    private void OnTypeChanged(ChangeEventArgs e) =>
        Vm.SelectedChocolateType = Enum.TryParse<ChocolateType>(e.Value?.ToString(), out var type) ? ChocolateTypeOption.For(type) : null;

    private void ClearForm()
    {
        Vm.ClearCommand.Execute(null);
        PullWeightFromPatient();
    }
}
