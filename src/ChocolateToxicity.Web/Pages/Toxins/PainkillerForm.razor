@page "/toxins/ibuprofen"
@page "/toxins/paracetamol"
@inherits ToxinPage<PainkillerViewModel>
@inject IServiceProvider Services
@inject NavigationManager NavigationManager

<PageTitle>@Vm.Title - Vet Calculator</PageTitle>

<PageHeader Title="@Vm.Title" Intro="@Vm.Intro" />
<DogOnlyNotice>
    <strong>Cat selected: the dog thresholds aren't used.</strong>
    @(Vm.Drug == Painkiller.Paracetamol
        ? "Paracetamol has no safe dose in cats; signs are reported from 10 mg/kg (Merck). Any ingestion is treated as toxic."
        : "Cats are about twice as sensitive to ibuprofen as dogs (Merck), so any ingestion is treated as potentially toxic.")
</DogOnlyNotice>

<form class="calc-form" @onsubmit="() => Vm.CalculateCommand.ExecuteAsync(null)" @onsubmit:preventDefault>
    <Field Label="Weight" For="weight" Error="@Vm.DogWeightError">
        <NumberInput Id="weight" Value="@Vm.DogWeightKg" ValueChanged="OnWeightChanged" Unit="kg" Placeholder="e.g. 12.5" Invalid="@(Vm.DogWeightError is not null)" />
    </Field>

    <Field Label="Strength per tablet" For="strength" Error="@Vm.StrengthError" Hint="@Vm.StrengthHint">
        <NumberInput Id="strength" Value="@Vm.StrengthMg" ValueChanged="v => Vm.StrengthMg = v" Unit="mg" Invalid="@(Vm.StrengthError is not null)" />
    </Field>

    <Field Label="Number eaten" For="count" Error="@Vm.CountError" Hint="If unsure, use the most that could be missing from the pack.">
        <NumberInput Id="count" Value="@Vm.Count" ValueChanged="v => Vm.Count = v" Placeholder="e.g. 2" Invalid="@(Vm.CountError is not null)" />
    </Field>

    <FormActions OnClear="ClearForm" />
</form>

@code {
    private PainkillerViewModel? vm;

    // One page serves both drugs; the URL picks the form.
    protected override PainkillerViewModel Vm => vm ??= Services.GetRequiredKeyedService<PainkillerViewModel>(
        NavigationManager.Uri.Contains("paracetamol", StringComparison.OrdinalIgnoreCase) ? Painkiller.Paracetamol : Painkiller.Ibuprofen);
}
