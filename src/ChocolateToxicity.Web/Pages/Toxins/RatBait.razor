@page "/toxins/rat-bait"
@inherits ToxinPage<RatBaitViewModel>
@inject RatBaitViewModel ViewModel

<PageTitle>Rat and mouse bait - Vet Calculator</PageTitle>

<PageHeader Title="Rat and mouse bait"
            Intro="Estimate the dose of a bait's active ingredient, and whether to consider inducing emesis. The ingredient and its concentration are on the pack." />
<DogOnlyNotice>
    @switch (Vm.SelectedIngredient?.Info)
    {
        case { LowestCatLd50MgPerKg: { } catLd50 } info:
            <strong>Cat thresholds used for @info.Name.</strong>
            @($" Toxic from one-tenth of the cat LD50 of {catLd50} mg/kg (Merola 2002 and Moorman 2002 agree; Merck's one-tenth rule).")
            break;
        case { Ingredient: RodenticideIngredient.Cholecalciferol }:
            <strong>These thresholds are for dogs. Feline data is lacking.</strong>
            @(" There is no published cat threshold for cholecalciferol. In one experimental study 8 of 10 cats given 0.375 mg/kg a day died (VPIS 2020), so treat this as a minimum estimate.")
            break;
        case { } info:
            <strong>These thresholds are for dogs. Feline data is lacking.</strong>
            @($" There is no agreed published cat LD50 for {info.Name}, so treat this as a minimum estimate. Warfarin and diphacinone have cat thresholds.")
            break;
        default:
            <strong>Cat thresholds are used for warfarin and diphacinone.</strong>
            @(" Feline data is lacking for the other ingredients, which use the dog thresholds.")
            break;
    }
</DogOnlyNotice>

<form class="calc-form" @onsubmit="() => Vm.CalculateCommand.ExecuteAsync(null)" @onsubmit:preventDefault>
    <SpeciesField />
    <Field Label="@($"{(Patient.Species == Species.Cat ? "Cat" : "Dog")}'s weight")" For="weight" Error="@Vm.DogWeightError">
        <NumberInput Id="weight" Value="@Vm.DogWeightKg" ValueChanged="OnWeightChanged" Unit="kg" Placeholder="e.g. 12.5" Invalid="@(Vm.DogWeightError is not null)" />
    </Field>

    <Field Label="Active ingredient" For="ingredient" Error="@Vm.IngredientError"
           Hint="If the pack is missing, choose Unknown anticoagulant: it uses the most potent one listed.">
        <select id="ingredient" value="@(Vm.SelectedIngredient?.Info.Ingredient.ToString() ?? "")" @onchange="OnIngredientChanged">
            <option value="">Choose...</option>
            @foreach (var option in Vm.Ingredients)
            {
                <option value="@option.Info.Ingredient">@option.Name</option>
            }
        </select>
    </Field>

    <Field Label="Concentration" For="concentration" Error="@Vm.ConcentrationError"
           Hint="Filled in with the usual strength for the ingredient. 0.005% is the same as 50 mg/kg or 50 ppm on a pack.">
        <NumberInput Id="concentration" Value="@Vm.ConcentrationPercent" ValueChanged="v => Vm.ConcentrationPercent = v" Unit="%" Invalid="@(Vm.ConcentrationError is not null)" />
    </Field>

    <Field Label="Bait eaten" For="bait" Error="@Vm.BaitEatenError" Hint="If unsure, use the most that could have been eaten.">
        <NumberInput Id="bait" Value="@Vm.BaitEatenGrams" ValueChanged="v => Vm.BaitEatenGrams = v" Unit="g" Placeholder="e.g. 25" Invalid="@(Vm.BaitEatenError is not null)" />
    </Field>

    <FormActions OnClear="ClearForm" />
</form>

@code {
    protected override RatBaitViewModel Vm => ViewModel;

    private void OnIngredientChanged(ChangeEventArgs e) =>
        Vm.SelectedIngredient = Enum.TryParse<RodenticideIngredient>(e.Value?.ToString(), out var ingredient) ? RodenticideOption.For(ingredient) : null;
}
