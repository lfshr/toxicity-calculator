@page "/toxins/grapes"
@inherits ToxinPage<GrapesViewModel>
@inject GrapesViewModel ViewModel

<PageTitle>Grapes and raisins - Vet Calculator</PageTitle>

<PageHeader Title="Grapes and raisins"
            Intro="There is no established safe dose of grapes or raisins: any amount can cause kidney injury in a susceptible dog. This shows the dose against the lowest doses reported to cause it." />
<DogOnlyNotice />

<form class="calc-form" @onsubmit="() => Vm.CalculateCommand.ExecuteAsync(null)" @onsubmit:preventDefault>
    <Field Label="Dog's weight" For="weight" Error="@Vm.DogWeightError">
        <NumberInput Id="weight" Value="@Vm.DogWeightKg" ValueChanged="OnWeightChanged" Unit="kg" Placeholder="e.g. 12.5" Invalid="@(Vm.DogWeightError is not null)" />
    </Field>

    <Field Label="What was eaten" For="form" Error="@Vm.FormError"
           Hint="Currants here means dried Zante currants. Fresh blackcurrants and redcurrants are not implicated.">
        <select id="form" value="@(Vm.SelectedForm?.Form.ToString() ?? "")" @onchange="OnFormChanged">
            <option value="">Choose...</option>
            @foreach (var option in Vm.Forms)
            {
                <option value="@option.Form">@option.Name</option>
            }
        </select>
    </Field>

    <Field Label="Amount eaten" For="amount" Error="@Vm.AmountEatenError"
           Hint="If unsure, use the most that could have been eaten. A snack box of raisins is usually 14 g.">
        <NumberInput Id="amount" Value="@Vm.AmountEatenGrams" ValueChanged="v => Vm.AmountEatenGrams = v" Unit="g" Placeholder="e.g. 50" Invalid="@(Vm.AmountEatenError is not null)" />
    </Field>

    <FormActions OnClear="ClearForm" />
</form>

@code {
    protected override GrapesViewModel Vm => ViewModel;

    private void OnFormChanged(ChangeEventArgs e) =>
        Vm.SelectedForm = Enum.TryParse<GrapeForm>(e.Value?.ToString(), out var form) ? GrapeFormOption.For(form) : null;
}
