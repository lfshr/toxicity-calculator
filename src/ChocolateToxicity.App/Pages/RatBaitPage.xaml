<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ChocolateToxicity.ViewModels;assembly=ChocolateToxicity.ViewModels"
             x:Class="ChocolateToxicity.App.Pages.RatBaitPage"
             x:DataType="vm:RatBaitViewModel"
             HideSoftInputOnTapped="True"
             Title="Rat and mouse bait">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Estimate the dose of a bait's active ingredient, and whether to consider inducing emesis. The ingredient and its concentration are on the pack."
                   Style="{StaticResource HintLabel}"
                   FontSize="15" />

            <!-- Dog's weight -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Dog's weight (kg)" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding DogWeightKg}" Placeholder="e.g. 12.5" Keyboard="Numeric" ReturnType="Next" />
                <Label Text="{Binding DogWeightError}"
                       Style="{StaticResource ErrorLabel}"
                       IsVisible="{Binding DogWeightError, Converter={StaticResource HasText}}" />
            </VerticalStackLayout>

            <!-- Active ingredient -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Active ingredient" Style="{StaticResource FieldLabel}" />
                <Picker Title="Choose the active ingredient"
                        ItemsSource="{Binding Ingredients}"
                        ItemDisplayBinding="{Binding Name, x:DataType=vm:RodenticideOption}"
                        SelectedItem="{Binding SelectedIngredient}" />
                <Label Text="If the pack is missing, choose Unknown anticoagulant: it uses the most potent one listed."
                       Style="{StaticResource HintLabel}" />
                <Label Text="{Binding IngredientError}"
                       Style="{StaticResource ErrorLabel}"
                       IsVisible="{Binding IngredientError, Converter={StaticResource HasText}}" />
            </VerticalStackLayout>

            <!-- Concentration -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Concentration (%)" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding ConcentrationPercent}" Placeholder="e.g. 0.005" Keyboard="Numeric" ReturnType="Next" />
                <Label Text="Filled in with the usual strength for the ingredient. 0.005% is the same as 50 mg/kg or 50 ppm on a pack."
                       Style="{StaticResource HintLabel}" />
                <Label Text="{Binding ConcentrationError}"
                       Style="{StaticResource ErrorLabel}"
                       IsVisible="{Binding ConcentrationError, Converter={StaticResource HasText}}" />
            </VerticalStackLayout>

            <!-- Amount eaten -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Bait eaten (g)" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding BaitEatenGrams}"
                       Placeholder="e.g. 25"
                       Keyboard="Numeric"
                       ReturnType="Done"
                       ReturnCommand="{Binding CalculateCommand}" />
                <Label Text="If unsure, use the most that could have been eaten."
                       Style="{StaticResource HintLabel}" />
                <Label Text="{Binding BaitEatenError}"
                       Style="{StaticResource ErrorLabel}"
                       IsVisible="{Binding BaitEatenError, Converter={StaticResource HasText}}" />
            </VerticalStackLayout>

            <Button Text="Calculate" Command="{Binding CalculateCommand}" FontSize="18" HeightRequest="52" />
            <Button Text="Clear" Command="{Binding ClearCommand}" Style="{StaticResource OutlineButton}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
